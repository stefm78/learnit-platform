{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnit.local/contracts/learnit-kit-v5.schema.json",
  "title": "Learn-it Student V0.1 explicit V5 canonical content contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "packageLineageId",
    "packageRevisionId",
    "packageRevisionDigest",
    "title",
    "versionLabel",
    "language",
    "courses"
  ],
  "properties": {
    "contract": {
      "const": "learnit.kit.v5"
    },
    "packageLineageId": {
      "$ref": "#/$defs/uuid"
    },
    "packageRevisionId": {
      "$ref": "#/$defs/uuid"
    },
    "packageRevisionDigest": {
      "$ref": "#/$defs/digest"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "versionLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "typedClaimId": {
      "type": "string",
      "pattern": "^atlas-claim-sha256:[0-9a-f]{64}$"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectiveId",
        "label"
      ],
      "properties": {
        "objectiveId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "$ref": "#/$defs/title"
        }
      }
    },
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "placement": {
          "enum": [
            "prompt",
            "content",
            "feedback"
          ]
        },
        "display": {
          "enum": [
            "contained",
            "full_width"
          ]
        },
        "zoomable": {
          "type": "boolean"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "type",
        "format",
        "alt",
        "pedagogicalRole",
        "data"
      ],
      "properties": {
        "assetId": {
          "$ref": "#/$defs/uuid"
        },
        "type": {
          "const": "image"
        },
        "format": {
          "enum": [
            "svg",
            "png",
            "jpeg",
            "webp"
          ]
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "caption": {
          "type": "string",
          "maxLength": 800
        },
        "pedagogicalRole": {
          "enum": [
            "concept_visual",
            "question_stimulus",
            "worked_example",
            "misconception_fix",
            "diagram_to_interpret",
            "memory_anchor"
          ]
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000000
        }
      }
    },
    "atlasValidationIndependenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimVersion",
        "claimId",
        "objectiveId",
        "sourceActivityLineageId",
        "targetActivityLineageId",
        "basisCode",
        "sourceStimulusDigest",
        "targetStimulusDigest"
      ],
      "properties": {
        "claimVersion": {
          "const": "atlas.independence.v1"
        },
        "claimId": {
          "$ref": "#/$defs/typedClaimId"
        },
        "objectiveId": {
          "$ref": "#/$defs/uuid"
        },
        "sourceActivityLineageId": {
          "$ref": "#/$defs/uuid"
        },
        "targetActivityLineageId": {
          "$ref": "#/$defs/uuid"
        },
        "basisCode": {
          "enum": [
            "new-instance",
            "new-context",
            "alternate-representation"
          ]
        },
        "sourceStimulusDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetStimulusDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "unitCommon": {
      "type": "object",
      "required": [
        "activityLineageId",
        "activityRevisionId",
        "activityRevisionDigest",
        "objectiveIds",
        "type",
        "learningPhase"
      ],
      "properties": {
        "activityLineageId": {
          "$ref": "#/$defs/uuid"
        },
        "activityRevisionId": {
          "$ref": "#/$defs/uuid"
        },
        "activityRevisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "objectiveIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "type": {
          "enum": [
            "qcm",
            "fill",
            "constructed",
            "lesson",
            "flashcard",
            "matching",
            "order",
            "classify"
          ]
        },
        "learningPhase": {
          "enum": [
            "activation",
            "comprehension",
            "application",
            "transfer",
            "consolidation",
            "diagnostic",
            "validation"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "media": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/mediaRef"
          }
        },
        "hints": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        },
        "references": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "evaluatedCommon": {
      "type": "object",
      "required": [
        "activityLineageId",
        "activityRevisionId",
        "activityRevisionDigest",
        "objectiveIds",
        "type",
        "prompt",
        "explanation",
        "difficulty",
        "learningPhase",
        "assessmentRole"
      ],
      "properties": {
        "activityLineageId": {
          "$ref": "#/$defs/uuid"
        },
        "activityRevisionId": {
          "$ref": "#/$defs/uuid"
        },
        "activityRevisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "objectiveIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "type": {
          "enum": [
            "qcm",
            "fill",
            "constructed",
            "lesson",
            "flashcard",
            "matching",
            "order",
            "classify"
          ]
        },
        "learningPhase": {
          "enum": [
            "activation",
            "comprehension",
            "application",
            "transfer",
            "consolidation",
            "diagnostic",
            "validation"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "media": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/mediaRef"
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "advanced",
            "expert"
          ]
        },
        "assessmentRole": {
          "enum": [
            "practice",
            "diagnostic",
            "validation"
          ]
        },
        "hints": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        },
        "references": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "qcmChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choiceId",
        "label"
      ],
      "properties": {
        "choiceId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "qcm": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "choices",
            "correctChoiceId"
          ],
          "properties": {
            "type": {
              "const": "qcm"
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/qcmChoice"
              }
            },
            "correctChoiceId": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "fillSegment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slotId"
          ],
          "properties": {
            "slotId": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      ]
    },
    "fillToken": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenId",
        "label",
        "maxUses"
      ],
      "properties": {
        "tokenId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "maxUses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "fillAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "tokenId"
      ],
      "properties": {
        "slotId": {
          "$ref": "#/$defs/uuid"
        },
        "tokenId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "fill": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "segments",
            "tokens",
            "answers"
          ],
          "properties": {
            "type": {
              "const": "fill"
            },
            "segments": {
              "type": "array",
              "minItems": 2,
              "maxItems": 60,
              "items": {
                "$ref": "#/$defs/fillSegment"
              }
            },
            "tokens": {
              "type": "array",
              "minItems": 1,
              "maxItems": 40,
              "items": {
                "$ref": "#/$defs/fillToken"
              }
            },
            "answers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "$ref": "#/$defs/fillAnswer"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "constructed": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "acceptedResponses"
          ],
          "properties": {
            "type": {
              "const": "constructed"
            },
            "acceptedResponses": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "lesson": {
      "allOf": [
        {
          "$ref": "#/$defs/unitCommon"
        },
        {
          "type": "object",
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "type": {
              "const": "lesson"
            },
            "title": {
              "$ref": "#/$defs/title"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            },
            "keyPoints": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "contextNote": {
              "type": "string",
              "maxLength": 1600
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "flashcard": {
      "allOf": [
        {
          "$ref": "#/$defs/unitCommon"
        },
        {
          "type": "object",
          "required": [
            "front",
            "back",
            "explanation"
          ],
          "properties": {
            "type": {
              "const": "flashcard"
            },
            "front": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "back": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "matchingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "label"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "matchingAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leftItemId",
        "rightItemId"
      ],
      "properties": {
        "leftItemId": {
          "$ref": "#/$defs/uuid"
        },
        "rightItemId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "matching": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "leftItems",
            "rightItems",
            "matches"
          ],
          "properties": {
            "type": {
              "const": "matching"
            },
            "leftItems": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/matchingItem"
              }
            },
            "rightItems": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/matchingItem"
              }
            },
            "matches": {
              "type": "array",
              "minItems": 2,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/matchingAnswer"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "orderItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "label"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        }
      }
    },
    "order": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "items",
            "correctOrder"
          ],
          "properties": {
            "type": {
              "const": "order"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 15,
              "items": {
                "$ref": "#/$defs/orderItem"
              }
            },
            "correctOrder": {
              "type": "array",
              "minItems": 2,
              "maxItems": 15,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucketId",
        "label"
      ],
      "properties": {
        "bucketId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "classifyItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "label"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "classifyAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "bucketId"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/uuid"
        },
        "bucketId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "classify": {
      "allOf": [
        {
          "$ref": "#/$defs/evaluatedCommon"
        },
        {
          "type": "object",
          "required": [
            "buckets",
            "items",
            "assignments"
          ],
          "properties": {
            "type": {
              "const": "classify"
            },
            "buckets": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/bucket"
              }
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 30,
              "items": {
                "$ref": "#/$defs/classifyItem"
              }
            },
            "assignments": {
              "type": "array",
              "minItems": 2,
              "maxItems": 30,
              "items": {
                "$ref": "#/$defs/classifyAssignment"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "courseLineageId",
        "courseRevisionId",
        "courseRevisionDigest",
        "title",
        "estimatedMinutes",
        "objectives",
        "activities"
      ],
      "properties": {
        "courseLineageId": {
          "$ref": "#/$defs/uuid"
        },
        "courseRevisionId": {
          "$ref": "#/$defs/uuid"
        },
        "courseRevisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 300
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/objective"
          }
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/qcm"
              },
              {
                "$ref": "#/$defs/fill"
              },
              {
                "$ref": "#/$defs/constructed"
              },
              {
                "$ref": "#/$defs/lesson"
              },
              {
                "$ref": "#/$defs/flashcard"
              },
              {
                "$ref": "#/$defs/matching"
              },
              {
                "$ref": "#/$defs/order"
              },
              {
                "$ref": "#/$defs/classify"
              }
            ]
          }
        },
        "atlasValidationIndependenceClaims": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/atlasValidationIndependenceClaim"
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "url",
        "label",
        "hook"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://\\S+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "\\S"
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800,
          "pattern": "\\S"
        }
      }
    }
  }
}
