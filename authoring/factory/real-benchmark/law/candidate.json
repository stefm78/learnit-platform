    "activities":[
      {"activityLineageId":"cf8b32f4-226b-4f6f-a739-ec25b3f3a05c","activityRevisionId":"b53b1f51-53ab-494c-ad05-63d5e8972fee","activityRevisionDigest":"sha256:77436bebdcf4776bbababfda7b81efb9df3efc38b2e69fd1618f13368534fab9","objectiveIds":["e607a437-29af-472d-bbf1-a44e5f69b179"],"type":"qcm","prompt":"D’après l’article I, section 1 de la Constitution reproduite dans le Senate Manual, où sont investis les pouvoirs législatifs accordés par la Constitution ?","explanation":"Le texte dispose que les pouvoirs législatifs accordés sont investis dans un Congrès des États-Unis composé d’un Sénat et d’une Chambre des représentants.","difficulty":"medium","learningPhase":"application","assessmentRole":"practice","estimatedMinutes":4,"choices":[{"choiceId":"6b7e4db7-a697-48c5-877e-d387e5e021b9","label":"Dans un Congrès composé d’un Sénat et d’une Chambre des représentants."},{"choiceId":"26cf714e-316e-4fc5-a471-34d5b1c77cae","label":"Dans le Président seul."},{"choiceId":"112715c5-3eb6-43a6-a80e-6087fa57b595","label":"Dans la Cour suprême seule."},{"choiceId":"bdbf9142-314b-4150-b604-3dd5c74d2e0e","label":"Dans les gouverneurs des États uniquement."}],"correctChoiceId":"6b7e4db7-a697-48c5-877e-d387e5e021b9"},
      {"activityLineageId":"6d45f9dd-181f-4614-980c-24aa534de459","activityRevisionId":"edfed635-ddbb-4c90-ac9b-9aa357f05c04","activityRevisionDigest":"sha256:f4320e5a58c9bb5ba960c5272745b51f382a27caf8d8ee0986e936ed90786f8f","objectiveIds":["e607a437-29af-472d-bbf1-a44e5f69b179"],"type":"qcm","prompt":"Une copie affirme que les membres de la Chambre des représentants sont choisis tous les quatre ans. Quelle correction correspond au texte constitutionnel ?","explanation":"L’article I, section 2 indique que les membres de la Chambre sont choisis « every second Year », donc tous les deux ans.","difficulty":"medium","learningPhase":"consolidation","assessmentRole":"practice","estimatedMinutes":4,"choices":[{"choiceId":"db561998-b864-495a-9cd0-dc4ef6098e9d","label":"Ils sont choisis tous les deux ans."},{"choiceId":"be7d4844-3bd4-4704-87fe-c6691d9aad56","label":"Ils sont choisis tous les quatre ans."},{"choiceId":"b0a5c0b8-dc6a-4439-8419-8cf7805f18a3","label":"Ils sont nommés à vie."},{"choiceId":"faf2b681-8458-46b1-809e-577cde472eeb","label":"Le texte ne prévoit aucune périodicité."}],"correctChoiceId":"db561998-b864-495a-9cd0-dc4ef6098e9d"},
