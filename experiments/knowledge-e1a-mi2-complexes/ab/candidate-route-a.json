eur de b²"},{"choiceId":"8feade81-723b-4f7a-85ea-922360b510d3","label":"Le degré du polynôme"}],"correctChoiceId":"1c2e95bf-907d-4ac0-8683-bbe739eaea28"},{"activityLineageId":"36f6ee16-b50b-4a1d-9547-ecd3223aefdb","activityRevisionId":"d8ce2e4a-5519-4358-9b52-ba17be6cd6de","activityRevisionDigest":"sha256:23e0cea54c3f35cc550ce83430a6c1c77984acf27530d35b2ce859a4b0c9ca4f","objectiveIds":["26c1bcef-ccfe-4d35-b46e-a4639784e05b"],"type":"qcm","prompt":"Quelles sont les racines cubiques de l’unité ?","explanation":"Le théorème 1.53 donne e^{i2kπ/3}, k=0,1,2 : 1, e^{i2π/3}, e^{i4π/3}.","difficulty":"medium","learningPhase":"application","assessmentRole":"practice","estimatedMinutes":4,"choices":[{"choiceId":"d1cc8f66-2a94-4364-a3ef-008e15df9a36","label":"1, e^{i2π/3}, e^{i4π/3}"},{"choiceId":"370ebd13-a532-4d9d-8c9e-0cad121e4511","label":"1, i, −1"},{"choiceId":"ca874920-a811-4e78-b69d-d3ada3c477cf","label":"e^{iπ/3}, e^{iπ}, e^{i5π/3}"},{"choiceId":"b703a994-abd2-4c2a-b81b-ad3c67eb8a6e","label":"1 et −1 seulement"}],"correctChoiceId":"d1cc8f66-2a94-4364-a3ef-008e15df9a36"},{"activityLineageId":"99cdd264-1d5a-4514-aab0-28595ea06390","activityRevisionId":"1d105ceb-0fb1-44c5-a54d-0ebd9d3dd96d","activityRevisionDigest":"sha256:a306df3806ef230733a8831568938f2ee7c6bdd3d8bb04e8c6bd1ea953225a75","objectiveIds":["26c1bcef-ccfe-4d35-b46e-a4639784e05b"],"type":"qcm","prompt":"Une réponse affirme que z⁴=1 a seulement les solutions 1 et −1. Quelle correction faut-il faire ?","explanation":"Le théorème 1.53 fournit quatre racines distinctes pour n=4 : 1, i, −1 et −i.","difficulty":"medium","learningPhase":"consolidation","assessmentRole":"practice","estimatedMinutes":4,"choices":[{"choiceId":"d1d43751-d850-44ad-acd9-1f25f8afb4a5","label":"Ajouter i et −i"},{"choiceId":"1c3d1280-5a58-43fb-8f9e-d6a5f9561f59","label":"Ajouter seulement i"},{"choiceId":"674948da-1404-4039-bc09-63a4244d2905","label":"Remplacer −1 par i"},{"choiceId":"091e4180-4ed8-4f53-8649-c8f11a379fee","label":"La réponse