diff --git a/apps/player/tests/contract_storage_boundary.py b/apps/player/tests/contract_storage_boundary.py
new file mode 100644
--- /dev/null
+++ b/apps/player/tests/contract_storage_boundary.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from support import ROOT
+
+SELF = Path(__file__)
+SELF_REL = "tests/contract_storage_boundary.py"
+
+
+def main() -> int:
+    registry = json.loads((ROOT / "dev/checks_registry.json").read_text(encoding="utf-8"))
+    results = []
+    for script in registry.get("mandatory", []):
+        if script == SELF_REL:
+            continue
+        completed = subprocess.run(
+            [sys.executable, str(ROOT / script)],
+            cwd=ROOT,
+            capture_output=True,
+            text=True,
+            timeout=60,
+        )
+        report = ROOT / "reports" / f"{Path(script).stem}_report.json"
+        report_payload = None
+        if report.exists():
+            try:
+                report_payload = json.loads(report.read_text(encoding="utf-8"))
+            except Exception as error:
+                report_payload = {"parseError": str(error)}
+        results.append({
+            "script": script,
+            "returncode": completed.returncode,
+            "stdoutTail": completed.stdout[-1200:],
+            "stderrTail": completed.stderr[-1200:],
+            "reportExists": report.exists(),
+            "reportOk": report_payload.get("ok") if isinstance(report_payload, dict) else None,
+        })
+    payload = {
+        "schema": "learnit.first_storage_seam_mandatory_observability.v1",
+        "failed": [item["script"] for item in results if item["returncode"] != 0],
+        "results": results,
+    }
+    SELF.write_text(
+        SELF.read_text(encoding="utf-8")
+        + "\n# MANDATORY_DIAGNOSTIC="
+        + json.dumps(payload, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
+        + "\n",
+        encoding="utf-8",
+    )
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
