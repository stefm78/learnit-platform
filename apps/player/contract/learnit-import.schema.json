          ]
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaRef"
          },
          "maxItems": 2
        },
        "type": {
          "const": "order"
        },
        "tokens": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "transfer_probe": {
          "type": "boolean"
        },
        "transfer_distance": {
          "enum": [
            "near",
            "far"
          ]
        },
        "variant_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "type",
        "objective",
        "question",
        "why",
        "remediation",
        "tokens",
        "answer"
      ]
    },
    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "advanced",
            "expert"
          ]
        },
        "learning_phase": {
          "enum": [
            "activation",
            "comprehension",
            "application",
            "transfer",
