        "question",
        "why",
        "remediation",
        "front",
        "answer",
        "back"
      ]
    },
    "activity": {
      "oneOf": [
        {
          "$ref": "#/$defs/qcm"
        },
        {
          "$ref": "#/$defs/fill"
        },
        {
          "$ref": "#/$defs/matching"
        },
        {
          "$ref": "#/$defs/order"
        },
        {
          "$ref": "#/$defs/flashcard"
        }
      ]
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "learnit-content-v2"
        },
        "contentVersion": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "library_presentation": {
          "type": "object"
        }
      },
      "required": [
        "schemaVersion",
        "contentVersion",
        "title",
        "sequence",
        "objectives",
        "activities"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "learnit-course-package"
        },
        "schema_version": {
          "const": "learnit.import.v1.1"
