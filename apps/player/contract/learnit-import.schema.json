{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnit.local/contracts/learnit-import-v1.1.schema.json",
  "title": "Learn-it strict authoring contract",
  "oneOf": [
    {
      "$ref": "#/$defs/package"
    },
    {
      "$ref": "#/$defs/course"
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "image"
        },
        "format": {
          "enum": [
            "svg",
            "png",
            "jpeg",
            "webp",
            "gif"
          ]
        },
        "source": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string"
        },
        "pedagogical_role": {
          "enum": [
            "concept_visual",
            "question_stimulus",
            "worked_example",
            "misconception_fix",
            "diagram_to_interpret",
            "memory_anchor"
          ]
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "src": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type",
        "format",
        "alt",
        "pedagogical_role"
      ],
      "anyOf": [
        {
          "required": [
            "data"
          ]
        },
        {
          "required": [
            "src"
          ]
        }
      ]
    },
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "placement": {
          "enum": [
            "question",
            "feedback"
          ]
        },
        "display": {
          "enum": [
            "contained",
            "full_width"
          ]
        },
        "zoomable": {
          "type": "boolean"
        }
      },
      "required": [
        "assetId"
      ]
    },
    "qcm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "advanced",
            "expert"
          ]
        },
        "learning_phase": {
          "enum": [
            "activation",
            "comprehension",
            "application",
            "transfer",
            "remediation",
            "consolidation",
            "diagnostic",
            "validation"
          ]
        },
        "assessment_role": {
          "enum": [
            "practice",
            "diagnostic",
            "validation",
            "remediation"
          ]
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaRef"
          },
          "maxItems": 2
        },
        "type": {
          "const": "qcm"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "transfer_probe": {
          "type": "boolean"
        },
        "transfer_distance": {
          "enum": [
            "near",
            "far"
          ]
        },
        "variant_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "type",
        "objective",
        "question",
        "why",
        "remediation",
        "choices",
        "answer"
      ]
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 420
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "advanced",
            "expert"
          ]
        },
        "learning_phase": {
          "enum": [
            "activation",
            "comprehension",
            "application",
            "transfer",
            "remediation",
            "consolidation",
            "diagnostic",
            "validation"
          ]
        },
        "assessment_role": {
          "enum": [
            "practice",
            "diagnostic",
            "validation",
            "remediation"
          ]
        },
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaRef"
          },
          "maxItems": 2
        },
        "type": {
          "const": "fill"
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ]
          }
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sentence": {
          "type": "string",
          "minLength": 1
        },
        "transfer_probe": {
          "type": "boolean"
        },
        "transfer_distance": {
          "enum": [
            "near",
            "far"
          ]
        },
        "variant_of": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "id",
        "type",
        "objective",
        "question",
        "why",
        "remediation",
        "parts",
        "tokens",
        "answer",
        "sentence"
      ]
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objective": {
          "type": "string",
          "minLength": 1,
