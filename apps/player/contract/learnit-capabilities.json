    "security": {
      "status": "stable",
      "schema": "learnit.media_security.rc684.v1",
      "svg_policy": "element-and-attribute-allowlist-fail-closed",
      "svg_forbidden": [
        "script",
        "foreignObject",
        "iframe",
        "image",
        "use",
        "event_attributes",
        "style",
        "external_href",
        "external_url()"
      ],
      "data_image_policy": "base64 raster only: png, jpeg, webp, gif",
      "remote_image_policy": "HTTPS only, no embedded credentials, no referrer",
      "data_url_max_chars": 5000000,
      "tested": true
    }
  },
  "compatibility": {
    "unknown_fields": "accepted_with_warning_by_runtime; rejected by strict authoring validator",
    "experimental_fields": "never generated by default",
    "deprecated_fields": "accepted only during an explicit transition window",
    "versioning": {
      "compatible_addition": "minor",
      "breaking_change": "major",
      "documentation_only": "skill patch"
    }
