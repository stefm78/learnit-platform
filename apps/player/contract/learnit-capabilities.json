        "attempt_evidence",
        "recurring_error_priority",
        "alternative_activity_first",
        "bounded_review_rounds"
      ],
      "tested": true
    },
    "remediation_variants": {
      "status": "stable",
      "generated_by_default": true,
      "matching_rule": "shared objective or common_errors; prefer a different activity type",
      "fallback": "retry source activity with reshuffled interaction state",
      "tested": true
    },
    "spaced_review": {
      "status": "stable",
      "generated_by_default": true,
      "authoring_fields": [],
      "schedule_owner": "runtime",
      "interval_hours": [
        24,
        72,
        168,
        336,
        720
      ],
      "failure_retry_hours": 8,
      "daily_limit": 8,
      "runtime": [
        "persisted_review_level",
        "deterministic_due_queue",
        "bounded_daily_load",
        "course_scoped_state",
        "legacy_progress_migration"
      ],
      "authoring_guidance": "No review date or interval is authored in kits; durable objectives and varied activities improve scheduled review quality.",
      "tested": true
    },
    "pedagogical_variety": {
      "status": "stable",
      "generated_by_default": true,
      "authoring_fields": [],
      "runtime": [
        "near_duplicate_audit",
        "meaningful_variant_filter",
        "deterministic_queue_diversification",
        "minimal_authored_order_displacement",
        "answer_mapping_preservation"
      ],
      "thresholds": {
        "near_duplicate": 0.82,
        "adjacent_repetition": 0.7
      },
      "authoring_guidance": "Write linked activities that change the situation, reasoning or interaction type; the runtime may separate avoidable adjacent repetitions but does not repair weak content design.",
      "tested": true
    },
    "session_modes": {
      "status": "stable",
      "generated_by_default": true,
      "authoring_fields": [],
      "policy_owner": "runtime",
      "schema": "learnit.session_modes.v1",
      "modes": [
        "discovery",
        "training",
        "review",
        "validation",
        "diagnostic"
      ],
      "runtime": [
        "single_session_controller",
        "policy_based_queue_selection",
        "deferred_assessment_feedback",
        "diagnostic_progress_isolation",
        "mode_transition_state_reset",
        "assessment_flashcard_exclusion",
        "learner_intent_guidance",
        "state_based_mode_recommendation",
        "diagnostic_validation_boundary_copy"
      ],
      "authoring_guidance": "Kits describe durable objectives, assessment roles and varied activities. The runtime guides learners from intent to mode; kits never encode learner familiarity, a recommended mode or runtime state.",
      "tested": true,
      "learner_intents": [
        "new-topic",
        "prior-knowledge",
        "continue-learning"
      ],
      "entry_guidance_owner": "runtime"
    },
    "explainable_learning_evidence": {
      "status": "stable",
      "generated_by_default": false,
      "authoring_fields": [
        "objective"
      ],
      "evidence_owner": "runtime",
      "aggregation_keys": [
        "objective",
        "chapter",
        "course"
      ],
      "evidence_dimensions": [
        "exposure",
        "attempts",
        "successes",
        "failures",
        "fragility",
        "review_due",
        "repeated_success",
        "spaced_success"
      ],
      "readable_statuses": [
        "not-started",
        "discovered",
        "in-progress",
        "fragile",
        "consolidated"
      ],
      "recommendation_contract": "Every recommendation exposes a verifiable reasonCode and a human-readable reason.",
      "forbidden_outputs": [
        "arbitrary_mastery_percentage",
        "index_based_objective_identity"
      ],
      "tested": true,
      "ui_status": "candidate-visible-pending-human-validation"
    },
    "learning_coverage_matrix": {
